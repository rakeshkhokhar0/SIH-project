# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.*
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Tooling and linters
.mypy_cache/
.ruff_cache/

# Uploads & generated data (preserve directory structure via __init__.py / .gitkeep)
uploads/documents/*
!uploads/documents/__init__.py
!uploads/documents/.gitkeep
uploads/images/*
!uploads/images/__init__.py
!uploads/images/.gitkeep
uploads/schedules/*
!uploads/schedules/__init__.py
!uploads/schedules/.gitkeep

# FAISS indexes & large model weights
faiss_indexes/*.index
faiss_indexes/*.bin
!faiss_indexes/__init__.py
!faiss_indexes/.gitkeep
ai_models/weights/
ai_models/*.pt
ai_models/*.bin
ai_models/*.onnx
ai_models/*.safetensors
!ai_models/__init__.py

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
